PROJECT_NAME=Insurance Management System API
API_VERSION=0.1.0
ENVIRONMENT=local

POSTGRES_DB=insurance_app
POSTGRES_USER=insurance_user
POSTGRES_PASSWORD=insurance_password

DATABASE_URL=postgresql+psycopg://insurance_user:insurance_password@localhost:5432/insurance_app
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

SECRET_KEY=change-this-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

SEED_ADMIN_EMAIL=admin@insurance.local
SEED_ADMIN_PASSWORD=11111111
SEED_ADMIN_FULL_NAME=System Administrator

EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
RAG_MIN_SCORE=0.08
RAG_TOP_K=5
RAG_MAX_CHUNKS_PER_DOCUMENT=80
RAG_ENTITY_EXTRACTION_BATCH_SIZE=5
RAG_PROCESSING_MODE=background
DOCUMENT_UPLOAD_DIR=uploads/documents

CLAIM_UPLOAD_DIR=uploads/claims
CLAIM_UPLOAD_MAX_BYTES=5242880
